{
  "manifest_version": 3,
  "name": "Sessions · PK",
  "description": "Un espace local pour vos onglets : sessions, favoris, tags, notes, archives et sauvegardes.",
  "version": "2026.9.1",
  "version_name": "2026.09.1",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "favicon"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "Ouvrir Sessions", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "commands": {
    "open-sessions": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Ouvrir Sessions"
    }
  }
}
