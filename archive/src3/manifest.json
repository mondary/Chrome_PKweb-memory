{
  "manifest_version": 3,
  "name": "Sessions · PK — SRC3",
  "description": "Vos onglets en une timeline sobre : session ouverte, captures locales au survol et sessions dépliables.",
  "version": "2026.9.2",
  "version_name": "2026.09.2",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "Ouvrir Sessions SRC3", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "commands": {
    "open-sessions": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Ouvrir Sessions"
    }
  }
}
