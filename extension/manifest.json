{
  "manifest_version": 3,
  "name": "Bookmarks Sorter",
  "description": "Organisez vos favoris Chrome avec historique local et miniatures mshots externes.",
  "version": "2026.9.25",
  "version_name": "2026.09.25",
  "key": "",
  "permissions": [
    "bookmarks",
    "history",
    "storage",
    "unlimitedStorage",
    "favicon",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Bookmarks Sorter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
