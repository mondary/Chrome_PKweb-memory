{
  "manifest_version": 3,
  "name": "PK Web Memory",
  "description": "Toute votre vie web organisée par mondary.design : favoris, historique et sessions réunis — explorez, nettoyez, retrouvez votre web.",
  "version": "2026.10.21",
  "version_name": "2026.10.21",
  "key": "",
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "tabGroups",
    "sessions",
    "storage",
    "unlimitedStorage",
    "favicon",
    "alarms",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "PK Web Memory",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
