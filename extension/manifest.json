{
  "manifest_version": 3,
  "name": "PK Web Memory",
  "description": "Toute votre vie web organisée : favoris, historique et sessions réunis. Explorez, nettoyez et retrouvez votre web.",
  "version": "2026.9.65",
  "version_name": "2026.09.65",
  "key": "",
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "favicon",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "PK Web Memory",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
