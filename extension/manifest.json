{
  "manifest_version": 3,
  "name": "PK Web Memory",
  "description": "Toute votre vie web organisée par mondary.design : favoris, historique, sessions. Made by PK-Labs.",
  "version": "2026.10.36",
  "version_name": "2026.10.36",
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "tabGroups",
    "sessions",
    "storage",
    "unlimitedStorage",
    "favicon",
    "alarms",
    "downloads",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "PK Web Memory — clic : panneau Respiration",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "commands": {
    "respiration-close-return": {
      "suggested_key": {
        "default": "Ctrl+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Respiration : fermer l'onglet actif « à revenir » et rappeler la page suivante (⌥⇧W)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
